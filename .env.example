# AI Email Threat Detection Platform - Environment Variables
# Copy this to .env.local and fill in your values

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Options: "gemini" | "openai" | "mock"
# Use "mock" for development without API keys
AI_PROVIDER=mock

# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=

# OpenAI API Key (get from https://platform.openai.com)
OPENAI_API_KEY=

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite database path (relative to project root)
DATABASE_PATH=./data/email-threat.db

# For PostgreSQL (future migration):
# DATABASE_URL=postgresql://user:password@localhost:5432/email_threat_db

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_APP_NAME="AI Email Threat Detection Platform"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Maximum file upload size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# ============================================
# SECURITY SETTINGS
# ============================================
# Secret for API authentication (generate a random string)
API_SECRET=your-random-secret-here

# Secret key for JWT / session token signing
AUTH_SECRET=your-secure-auth-secret-key-at-least-32-chars

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_ENABLE_REPORTS=true
